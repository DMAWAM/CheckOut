VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public half of the VAPID keypair used for Web Push.
# Generate with: npx web-push generate-vapid-keys --json
# The PRIVATE half belongs as a Supabase secret (VAPID_PRIVATE_KEY) — never commit it.
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key
